# Solo orders.php y leads.php necesitan ser accesibles por HTTP directo
# (los llama el sitio al confirmar un pedido o pedir que lo llamen).
# db.php tiene las credenciales reales de la base de datos — aunque PHP
# normalmente lo ejecuta en vez de mostrarlo, esto es una segunda barrera
# por si alguna vez el servidor deja de ejecutar PHP correctamente aca.
<IfModule mod_authz_core.c>
    <FilesMatch "^(?!orders\.php$|leads\.php$).*$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(?!orders\.php$|leads\.php$).*$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
