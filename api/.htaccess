# Solo orders.php necesita ser accesible por HTTP directo (lo llama el
# sitio al confirmar un pedido). db.php tiene las credenciales reales de
# la base de datos — aunque PHP normalmente lo ejecuta en vez de mostrarlo,
# esto es una segunda barrera por si alguna vez el servidor deja de
# ejecutar PHP correctamente en esta carpeta.
<IfModule mod_authz_core.c>
    <FilesMatch "^(?!orders\.php$).*$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(?!orders\.php$).*$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
